{
  "expo": {
    "name": "Мир Гольфа",
    "slug": "mir-golfa",
    "version": "2.2.0",
    "orientation": "portrait",
    "scheme": "mirgolfa",
    "description": "Календарь турниров по гольфу и мини-гольфу: даты, клубы, результаты и личная статистика. Каждое событие со ссылкой на первоисточник.",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "ru.mirgolf.app",
      "versionCode": 22,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "ios": {
      "bundleIdentifier": "ru.mirgolf.app",
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Мир Гольфа",
      "shortName": "Мир Гольфа",
      "themeColor": "#1B4D3E",
      "backgroundColor": "#FFFFFF"
    },
    "experiments": {
      "baseUrl": "/mir-golfa"
    }
  }
}
